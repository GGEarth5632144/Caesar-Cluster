# Copy to .env before running `docker compose up` (this file is git-ignored).
# Values below are dev-only defaults — safe to keep as-is for local runs.

# --- postgres ---
POSTGRES_DB=cloud_cluster
POSTGRES_PASSWORD=password

# --- backend (Go API) — full docs in backend/.env.example ---
PORT=8080
DB_URL=postgres://postgres:password@db:5432/cloud_cluster?sslmode=disable
JWT_SECRET=dev-secret
FRONTEND_ORIGIN=http://localhost:5173
PROVISIONER=mock

# --- frontend (Vite) — full docs in "frontend/caesar cluster/.env.example" ---
VITE_API_URL=http://localhost:8080/api
VITE_MOCK_AI=true

# ─────────────────────────────────────────────────────────────
# แจ้งเตือนจาก log (หน้า Alerts)
# ─────────────────────────────────────────────────────────────
# backend เดินอ่าน log ของทุก service ที่ running อยู่เป็นรอบๆ เจอบรรทัดที่เป็น error
# จะสรุปเป็นแจ้งเตือนส่งให้สมาชิกทุกคนใน namespace นั้น แล้วโชว์เป็นตัวเลขแดงบน Sidebar
ALERT_SCAN_ENABLED=true
ALERT_SCAN_INTERVAL_SECONDS=60
ALERT_SCAN_MAX_LINES=500
# true = ส่ง warning เข้าหน้า Alerts ด้วย (ค่าปกติส่งเฉพาะ error เพื่อไม่ให้แจ้งเตือนเฟ้อ)
ALERT_SCAN_INCLUDE_WARNINGS=false
