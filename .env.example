# Copy to .env before running `docker compose up` (this file is git-ignored).
# Values below are dev-only defaults — safe to keep as-is for local runs.

# --- postgres ---
POSTGRES_DB=cloud_cluster
POSTGRES_PASSWORD=password

# --- backend (Go API) — full docs in backend/.env.example ---
PORT=8080
DB_URL=postgres://postgres:password@db:5432/cloud_cluster?sslmode=disable
JWT_SECRET=dev-secret
FRONTEND_ORIGIN=http://localhost:5173
PROVISIONER=mock

# --- frontend (Vite) — full docs in "frontend/caesar cluster/.env.example" ---
VITE_API_URL=http://localhost:8080/api
VITE_MOCK_AI=true
