# Copy to .env before running `docker compose up` (this file is git-ignored).
# Values below are dev-only defaults — safe to keep as-is for local runs.

# --- postgres ---
POSTGRES_DB=cloud_cluster
POSTGRES_PASSWORD=password

# --- backend (Go API) — full docs in backend/.env.example ---
PORT=8080
DB_URL=postgres://postgres:password@db:5432/cloud_cluster?sslmode=disable
JWT_SECRET=dev-secret
FRONTEND_ORIGIN=http://localhost:5173
PROVISIONER=mock

# --- อีเมล: ลิงก์ยืนยันตอนสมัคร + ลิงก์รีเซ็ตรหัสผ่าน (SMTP ของ Gmail) ---
# full docs (รวมเรื่อง "ทำไมเมลเข้าสแปม") อยู่ที่ backend/.env.example
#
# ไม่ตั้งสองค่านี้ = สมัครสมาชิกและรีเซ็ตรหัสผ่านใช้ไม่ได้เลย (บน APP_ENV=production จะไม่ยอม start)
# ต้องเป็น App password 16 ตัว ไม่ใช่รหัสผ่านที่ใช้ล็อกอิน Google
# (สร้างที่ https://myaccount.google.com/apppasswords หลังเปิด 2-Step Verification)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (ค่าปกติ) | 465 = TLS ตั้งแต่ต้น ใช้เมื่อเน็ตปลายทางบล็อก 587
SMTP_PORT=587
MAIL_FROM_NAME=Caesar Cluster
# อีเมลที่ผู้ใช้ตอบกลับได้จริง (ว่าง = ไม่ใส่ Reply-To) — ช่วยให้เมลไม่ตกสแปม
MAIL_REPLY_TO=
RESET_TOKEN_TTL_MINUTES=30
VERIFY_TOKEN_TTL_HOURS=24

# --- frontend (Vite) — full docs in "frontend/caesar cluster/.env.example" ---
VITE_API_URL=http://localhost:8080/api
VITE_MOCK_AI=true

# ─────────────────────────────────────────────────────────────
# ข้อมูลตั้งต้น (cmd/seed)
# ─────────────────────────────────────────────────────────────
# บนเครื่องจริง (APP_ENV=production) seed จะ "ไม่ใส่" ข้อมูลสาธิตให้เองอัตโนมัติ
# คือบัญชีทดสอบ B6618452 กับรายชื่อ eligible ปลอม B6600001-B6600010
# ที่มีรหัสผ่านเขียนตายอยู่ในซอร์สที่ใครก็อ่านได้จาก repo
# ตั้งเป็น true ถ้าจงใจอยากได้ (เช่นเครื่อง staging ที่ต้องการข้อมูลทดสอบครบ)
SEED_DEMO_DATA=

# รหัสผ่านตั้งต้นของบัญชี admin — production บังคับตั้งเอง ยาวอย่างน้อย 12 ตัว
# ไม่ตั้ง (หรือตั้งเป็นค่าตัวอย่าง changeme123) seed จะไม่ยอมรันเลย
# สร้างได้ด้วย: openssl rand -base64 24
SEED_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# แจ้งเตือนจาก log (หน้า Alerts)
# ─────────────────────────────────────────────────────────────
# backend เดินอ่าน log ของทุก service ที่ running อยู่เป็นรอบๆ เจอบรรทัดที่เป็น error
# จะสรุปเป็นแจ้งเตือนส่งให้สมาชิกทุกคนใน namespace นั้น แล้วโชว์เป็นตัวเลขแดงบน Sidebar
ALERT_SCAN_ENABLED=true
ALERT_SCAN_INTERVAL_SECONDS=60
ALERT_SCAN_MAX_LINES=500
# true = ส่ง warning เข้าหน้า Alerts ด้วย (ค่าปกติส่งเฉพาะ error เพื่อไม่ให้แจ้งเตือนเฟ้อ)
ALERT_SCAN_INCLUDE_WARNINGS=false
