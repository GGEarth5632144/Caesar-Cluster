# Caesar Cluster — ค่าตั้งต้นสำหรับรันบนเครื่องจริงด้วย docker-compose.prod.yml
#
#   cp .env.example .env    แล้วแก้ค่าที่มีเครื่องหมาย <<< ให้ครบก่อน up
#
# ไฟล์ .env ถูก .gitignore ไว้ อย่า commit ขึ้น repo เด็ดขาด

# ─────────────────────────────────────────────────────────────
# โหมดการรัน
# ─────────────────────────────────────────────────────────────
# production = ล็อก CORS ไว้ที่ FRONTEND_ORIGIN อย่างเดียว, ปิด debug log ของ gin,
#              และไม่ยอม start ถ้า JWT_SECRET ยังเป็นค่าตัวอย่าง
APP_ENV=production
TZ=Asia/Bangkok

# พอร์ตที่เปิดออกมาที่เครื่อง NUC สำหรับเข้าหน้าเว็บ
# เลี่ยง 9090 และ 9100 เพราะ Prometheus กับ Node Exporter ใช้อยู่แล้ว
# ถ้าอยากใช้ 80 ให้เปลี่ยนเป็น WEB_PORT=80
WEB_PORT=8081

# ─────────────────────────────────────────────────────────────
# ฐานข้อมูล
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=caesar
POSTGRES_DB=cloud_cluster
# <<< ตั้งรหัสผ่านใหม่ ใช้ตัวอักษรและตัวเลขเท่านั้น (อักขระพิเศษต้อง URL-encode ใน connection string)
#     สร้างได้ด้วย: openssl rand -hex 24
POSTGRES_PASSWORD=

# ─────────────────────────────────────────────────────────────
# ความปลอดภัย
# ─────────────────────────────────────────────────────────────
# <<< ต้องยาวอย่างน้อย 32 ตัวอักษร ระบบจะไม่ยอม start ถ้ายังเป็น dev-secret
#     สร้างได้ด้วย: openssl rand -base64 48
#     เปลี่ยนค่านี้เมื่อไร token ที่ผู้ใช้ถืออยู่จะใช้ไม่ได้ทั้งหมด (ทุกคนต้อง login ใหม่)
JWT_SECRET=

JWT_TTL_HOURS=24
JWT_REMEMBER_TTL_DAYS=30

# <<< URL ที่ผู้ใช้เปิดหน้าเว็บจริงๆ ต้องตรงเป๊ะรวม scheme และพอร์ต
#     ใช้ 2 อย่าง: เป็น origin ที่อนุญาตใน CORS และเป็นฐานของลิงก์ในอีเมลรีเซ็ตรหัสผ่าน
FRONTEND_ORIGIN=http://192.168.192.1:8081

# ─────────────────────────────────────────────────────────────
# การเชื่อมต่อคลัสเตอร์
# ─────────────────────────────────────────────────────────────
# mock       = ไม่แตะคลัสเตอร์เลย แค่จองโควตาใน DB (ใช้ทดสอบระบบก่อน)
# kubernetes = สร้าง Namespace + ResourceQuota + LimitRange + NetworkPolicy + Deployment จริง
PROVISIONER=kubernetes

# path ของ kubeconfig บนเครื่อง NUC ที่จะ mount เข้า container
# ต้องมีไฟล์นี้อยู่จริงก่อน up เสมอ แม้ตอนรัน mock (ไม่งั้น Docker สร้างเป็นโฟลเดอร์ให้แทน)
KUBECONFIG_HOST_PATH=./secrets/kubeconfig

# ช่วง IP ของ pod ทั้งคลัสเตอร์ — ค่านี้คือค่าที่ Calico ใช้อยู่ตามเอกสารสถาปัตยกรรม
# NetworkPolicy ใช้กันไม่ให้ pod ของ space หนึ่งคุยข้ามไปหา pod ของ space อื่น
K8S_POD_CIDR=172.16.0.0/16

# วง IP ที่ห้าม pod ของนักศึกษาต่อออกไป คั่นด้วย comma
# ค่า default คือ VLAN100 ของ node ทุกตัว กันไม่ให้ container ยิงเข้า SSH หรือ kubelet ของ node
# เพิ่มวง ZeroTier เข้าไปด้วยถ้าไม่อยากให้ pod มองเห็นวงผู้ดูแล
K8S_BLOCKED_EGRESS_CIDRS=192.168.100.0/24,192.168.192.0/24

# port ที่ใช้เมื่อผู้ใช้ไม่ระบุ container_port และ image ไม่ได้บอกผ่าน env PORT
K8S_DEFAULT_CONTAINER_PORT=8080

# baseline   = กัน privileged / hostPath / hostNetwork แต่ยังรัน image ที่เป็น root ได้ (แนะนำสำหรับเริ่มต้น)
# restricted = เข้มสุด บังคับ runAsNonRoot ด้วย — image ยอดนิยมหลายตัวจะรันไม่ขึ้น
K8S_POD_SECURITY=baseline

K8S_IMAGE_PULL_POLICY=IfNotPresent
K8S_REQUEST_TIMEOUT_SECONDS=30

# ─────────────────────────────────────────────────────────────
# จำกัด image ที่ผู้ใช้ deploy ได้ (คั่นด้วย comma, ว่าง = ไม่จำกัด)
# ─────────────────────────────────────────────────────────────
# ว่างไว้ = นักศึกษารัน image อะไรก็ได้บนคลัสเตอร์ รวมถึง image ขุดเหรียญ
# เทียบกับชื่อที่ normalize แล้ว เช่น nginx จะถูกมองเป็น docker.io/library/nginx
ALLOWED_IMAGE_REGISTRIES=docker.io/library/,ghcr.io/,registry.k8s.io/
# ─────────────────────────────────────────────────────────────
# แจ้งเตือนจาก log (หน้า Alerts)
# ─────────────────────────────────────────────────────────────
# backend เดินอ่าน log ของทุก service ที่ running อยู่เป็นรอบๆ เจอบรรทัดที่เป็น error
# จะสรุปเป็นแจ้งเตือนส่งให้สมาชิกทุกคนใน namespace นั้น แล้วโชว์เป็นตัวเลขแดงบน Sidebar
#
# ยิ่งถี่ยิ่งรู้เร็ว แต่ก็ยิง Kubernetes API ถี่ขึ้นตามไปด้วย — 60 วินาทีเป็นจุดที่สมดุลสำหรับ
# control-plane ตัวเดียวบน NUC ลดลงได้ถ้าคลัสเตอร์โตขึ้นและมี node แยกสำหรับ control plane
ALERT_SCAN_ENABLED=true
ALERT_SCAN_INTERVAL_SECONDS=60
ALERT_SCAN_MAX_LINES=500
# true = ส่ง warning เข้าหน้า Alerts ด้วย (ค่าปกติส่งเฉพาะ error เพื่อไม่ให้แจ้งเตือนเฟ้อ)
ALERT_SCAN_INCLUDE_WARNINGS=false

# ─────────────────────────────────────────────────────────────
# อีเมลรีเซ็ตรหัสผ่าน (Resend)
# ─────────────────────────────────────────────────────────────
# ว่างไว้ระบบยังรันได้ แต่ผู้ใช้กด "ลืมรหัสผ่าน" แล้วจะไม่ได้อีเมล
RESEND_API_KEY=
MAIL_FROM=Caesar Cluster <onboarding@resend.dev>
RESET_TOKEN_TTL_MINUTES=30

# ─────────────────────────────────────────────────────────────
# หน้าเว็บ (อ่านตอน container start ไม่ต้อง build ใหม่เมื่อแก้)
# ─────────────────────────────────────────────────────────────
# /api = ยิงผ่าน nginx ตัวเดียวกับที่เสิร์ฟหน้าเว็บ ไม่ต้องเปิดพอร์ต backend ออกนอกเครื่อง
CAESAR_API_URL=/api

# Cluster AI ยังไม่มีในระบบนี้ — ปล่อย MOCK ไว้ก่อนจนกว่าจะติดตั้งบน AGX Orin เสร็จ
CAESAR_MOCK_AI=true
CAESAR_AI_API_URL=
