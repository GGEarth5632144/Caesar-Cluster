# ไฟล์ env รวมของทั้งโปรเจค (postgres + backend + frontend)
#
#   cp .env.example .env
#   docker compose up --build
#
# ค่า default ด้านล่างเป็นค่าสำหรับ dev
# (ยกเว้นอีเมล — ดูหัวข้อ SMTP ถ้าจะทดสอบสมัครสมาชิก/รีเซ็ตรหัสผ่าน)
#
# ใครอ่านค่าอะไรบ้าง:
#   POSTGRES_*                     → container postgres ตอนสร้าง db ครั้งแรก
#   ตั้งแต่ APP_ENV ถึง PATH_PROMETHEUS_QUERY → backend (Go) ผ่าน internal/config
#   VITE_*                         → frontend (Vite) — ต้องขึ้นต้นด้วย VITE_ เท่านั้นถึงจะถึงมือ browser

# ─────────────────────────────────────────────────────────────
# โหมดการรัน
# ─────────────────────────────────────────────────────────────
# development = ผ่อน CORS ให้ localhost ทุกพอร์ต และเปิด debug log ของ gin
# production  = ล็อก CORS ไว้ที่ FRONTEND_ORIGIN อย่างเดียว, ไม่ยอม start ถ้า JWT_SECRET ยังอ่อน
#               หรือยังไม่ได้ตั้ง SMTP และ seed จะไม่ใส่ข้อมูลสาธิตให้เอง
APP_ENV=development

# ─────────────────────────────────────────────────────────────
# Postgres (service `db` ใน docker-compose)
# ─────────────────────────────────────────────────────────────
# ใช้ตอนสร้าง volume ครั้งแรกเท่านั้น — แก้ทีหลังต้อง `docker compose down -v` ก่อนถึงจะมีผล
# user เป็น `postgres` เสมอ (ค่า default ของ image) ถ้าเปลี่ยนค่าพวกนี้ต้องแก้ DB_URL ให้ตรงกันด้วย
POSTGRES_DB=cloud_cluster
POSTGRES_PASSWORD=password

# ─────────────────────────────────────────────────────────────
# Backend (Go API)
# ─────────────────────────────────────────────────────────────
PORT=8080

# host `db` = ชื่อ service ใน docker-compose (ใช้ได้เฉพาะตอนรันด้วย docker)
# ถ้ารัน `go run ./cmd/server` เองบนเครื่อง ให้เปลี่ยนเป็น @localhost:5433
# (5433 คือพอร์ตที่ docker-compose แม็ป postgres ออกมา กันชนกับ postgres ที่ลงไว้ในเครื่องที่ 5432)
DB_URL=postgres://postgres:password@db:5432/cloud_cluster?sslmode=disable

# บน APP_ENV=production ต้องยาวอย่างน้อย 32 ตัว ไม่งั้นไม่ยอม start
# (สร้างด้วย: openssl rand -base64 48) — หลุดเมื่อไหร่ = ปลอม JWT เป็น admin ได้ทันที
JWT_SECRET=dev-secret

# ต้นทางที่ CORS ยอมให้เรียก และเป็นโดเมนที่ลิงก์ในอีเมลชี้ไปหา
FRONTEND_ORIGIN=http://localhost:5173

# อายุ JWT ปกติ (ชม.) — ไม่ติ๊ก "Remember For 30 Days" ตอน login
JWT_TTL_HOURS=24
# อายุ JWT ตอนติ๊ก "Remember For 30 Days" (วัน)
JWT_REMEMBER_TTL_DAYS=30

# ─────────────────────────────────────────────────────────────
# Provisioner (ตัวที่ไปสร้างของจริงบน cluster)
# ─────────────────────────────────────────────────────────────
# mock = ไม่แตะ cluster จริง แค่ log ออกมา (ใช้ตอน dev) | kubernetes = deploy ขึ้น k8s จริง
PROVISIONER=mock
# ใช้เมื่อ PROVISIONER=kubernetes เท่านั้น — path ของ kubeconfig
# เว้นว่างไว้ถ้า server รันอยู่ใน cluster เอง (จะใช้ in-cluster config)
KUBECONFIG=

# ─────────────────────────────────────────────────────────────
# ข้อมูลตั้งต้น (cmd/seed — รันเป็น service `seed` ให้อัตโนมัติตอน docker compose up)
# ─────────────────────────────────────────────────────────────
# ข้อมูลสาธิต = บัญชีทดสอบ B6618452 + รายชื่อ eligible ปลอม B6600001-B6600010
# ที่มีรหัสผ่านเขียนตายอยู่ในซอร์สที่ใครก็อ่านได้จาก repo
# ไม่ตั้ง = ใส่ให้ตอน dev, ไม่ใส่ตอน APP_ENV=production (ตั้งทับได้ทั้งสองทาง)
SEED_DEMO_DATA=

# รหัสผ่านตั้งต้นของบัญชี admin — ตอน dev ไม่ตั้งก็ได้ (ใช้ changeme123)
# ตอน production "บังคับตั้ง" ยาวอย่างน้อย 12 ตัว ไม่งั้น seed จะไม่ยอมรัน
# สร้างได้ด้วย: openssl rand -base64 24
SEED_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# แจ้งเตือนจาก log (หน้า Alerts)
# ─────────────────────────────────────────────────────────────
# backend เดินอ่าน log ของทุก service ที่ running อยู่เป็นรอบๆ เจอบรรทัดที่เป็น error
# จะสรุปเป็นแจ้งเตือนส่งให้สมาชิกทุกคนใน namespace นั้น แล้วโชว์เป็นตัวเลขแดงบน Sidebar
# false = ปิดตัวสแกน (หน้า Alerts ยังเปิดดูได้ แต่จะไม่มีแจ้งเตือนใหม่เข้ามาเอง)
ALERT_SCAN_ENABLED=true
# ทุกกี่วินาทีจะเดินอ่าน log ของทุก service ที่ running อยู่หนึ่งรอบ
ALERT_SCAN_INTERVAL_SECONDS=60
# ดึง log ย้อนหลังสูงสุดกี่บรรทัดต่อ service ต่อรอบ (กัน container ที่พ่น log รัวๆ กินแรม)
ALERT_SCAN_MAX_LINES=500
# true = ส่ง warning เข้าหน้า Alerts ด้วย (ค่าปกติส่งเฉพาะ error เพื่อไม่ให้แจ้งเตือนเฟ้อ)
ALERT_SCAN_INCLUDE_WARNINGS=false

# ─────────────────────────────────────────────────────────────
# อีเมล: ลิงก์ยืนยันตอนสมัคร + ลิงก์รีเซ็ตรหัสผ่าน (SMTP ของ Gmail)
# ─────────────────────────────────────────────────────────────
# โควตาของ Gmail ฟรีคือ ~500 ฉบับ/วัน พอเหลือเฟือสำหรับระบบนี้
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (ค่าปกติ) | 465 = TLS ตั้งแต่ต้น ใช้เมื่อเน็ตปลายทางบล็อก 587
SMTP_PORT=587

# อีเมลเต็มของบัญชี no-reply — ว่างไว้ระบบยังรันบน dev ได้ แต่สมัครสมาชิกและรีเซ็ตรหัสผ่านจะใช้ไม่ได้
# (บน APP_ENV=production ไม่ยอม start เลยถ้าไม่ตั้ง เพราะลิงก์ยืนยันอยู่บนเส้นทางบังคับของการสมัคร)
SMTP_USERNAME=
# ต้องเป็น App password 16 ตัว ไม่ใช่รหัสผ่านที่ใช้ล็อกอิน Google
# (สร้างที่ https://myaccount.google.com/apppasswords หลังเปิด 2-Step Verification)
SMTP_PASSWORD=

# ชื่อที่ผู้รับเห็นหน้าอีเมลผู้ส่ง — ส่วนที่อยู่จะเป็น SMTP_USERNAME เสมอ (Gmail บังคับ)
MAIL_FROM_NAME=Caesar Cluster
# อีเมลที่ผู้ใช้ตอบกลับได้จริง (ว่าง = ไม่ใส่ header Reply-To)
# กล่อง no-reply ที่ตอบกลับไม่ได้เลยถูกตัวกรองสแปมหักคะแนน ใส่อีเมลผู้ดูแลไว้ช่วยให้เข้า inbox ง่ายขึ้น
MAIL_REPLY_TO=

# อายุของลิงก์รีเซ็ตรหัสผ่าน (นาที)
RESET_TOKEN_TTL_MINUTES=30
# อายุของลิงก์ยืนยันอีเมลตอนสมัคร (ชั่วโมง) — ยาวกว่าลิงก์รีเซ็ตเพราะคนเพิ่งสมัครอาจไปเปิดเมล
# เช้าวันรุ่งขึ้น ต่างจากคนกดรีเซ็ตที่นั่งรออยู่หน้าจอ
VERIFY_TOKEN_TTL_HOURS=24

# ─────────────────────────────────────────────────────────────
# Telemetry (ดึงอุณหภูมิ/RAM/สถานะของโหนดจาก Prometheus ทุก 5 วินาที)
# ─────────────────────────────────────────────────────────────
# URL แบบเต็มของ endpoint query พร้อม %s ตรงที่จะแทน PromQL เช่น
#   http://<prometheus-host>:9090/api/v1/query?query=%s
# ว่าง = ปิดการดึง (worker ยังเดินอยู่แต่ยิงไม่ออก ไม่มีข้อมูลลงตาราง node_telemetries)
PATH_PROMETHEUS_QUERY=

# ─────────────────────────────────────────────────────────────
# Frontend (Vite) — ค่าเหล่านี้ถูก inline ลง bundle ตอน build ห้ามใส่ความลับ
# ─────────────────────────────────────────────────────────────
# URL ของ Caesar Cluster API ที่ browser จะเรียก (ต้องเป็น URL ที่เปิดจากเครื่องผู้ใช้ได้ ไม่ใช่ชื่อ service ใน docker)
VITE_API_URL=http://localhost:8080/api

# true = จำลอง AI pipeline ทั้งหมดในฝั่ง frontend ทดสอบ UI ได้โดยไม่ต้องรัน Cluster AI
VITE_MOCK_AI=true
# URL ของ Cluster AI Go server (ใช้เมื่อ VITE_MOCK_AI=false) — บนเครื่องจริงคือ http://<agx-orin-ip>:8090
VITE_AI_API_URL=http://localhost:8090
