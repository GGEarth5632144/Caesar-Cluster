# .env ของ production บน NUC — ใช้คู่กับ prod-compose.yml (วางไว้โฟลเดอร์เดียวกัน)
#
#   cp .env.example .env && chmod 600 .env
#   กรอกทุกค่าที่ว่าง แล้ว: docker compose -f prod-compose.yml up -d
#
# ค่าที่ว่างในไฟล์นี้ "ตั้งใจให้ว่าง": ลืมกรอก = compose หรือ backend ไม่ยอม start
# ดีกว่าใส่ค่าตัวอย่างที่ยาวพอผ่านด่าน แล้วมีคนเผลอใช้ค่านั้นบนเครื่องจริง
#
# ห้าม commit ค่าจริง (repo นี้ public) · ค่าห้ามมีเครื่องหมาย $ (compose จะแปลเป็นตัวแปร)
# ห้ามตั้ง PORT — nginx ใน image frontend ชี้ backend:8080 ตายตัว

# ─────────────────────────────────────────────────────────────
# Image (Docker Hub)
# ─────────────────────────────────────────────────────────────
DOCKERHUB_USER=
# tag ที่ push ขึ้นไป — แนะนำ git short sha (รู้ว่ารันโค้ดเวอร์ชันไหน ย้อนกลับได้) แทน latest
IMAGE_TAG=

# ─────────────────────────────────────────────────────────────
# เว็บ (nginx ใน image frontend)
# ─────────────────────────────────────────────────────────────
# IP ของ NUC ที่จะเปิดเว็บ เช่น IP ขาที่นักศึกษาเข้าถึง — 0.0.0.0 = เปิดทุกขา (รวม ZeroTier/VLAN ภายใน)
WEB_BIND_IP=
# เช็คก่อนว่าพอร์ตว่าง: sudo ss -ltnp | grep ':80 '
WEB_PORT=80

# ต้นทางที่ผู้ใช้เปิดเว็บจริง: scheme + host (+ :พอร์ต ถ้าไม่ใช่ 80/443) ตรงกับที่พิมพ์ในเบราว์เซอร์เป๊ะ
# ใช้ 2 ที่: CORS ของ backend (production ยอมแค่ origin นี้) และลิงก์ในอีเมลยืนยัน/รีเซ็ตรหัสผ่าน
FRONTEND_ORIGIN=

# ─────────────────────────────────────────────────────────────
# โหมด — production: CORS ล็อกที่ FRONTEND_ORIGIN, บังคับ secret แข็งแรง + SMTP, seed ไม่ใส่ข้อมูลสาธิต
# ─────────────────────────────────────────────────────────────
APP_ENV=production

# ─────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────
POSTGRES_DB=cloud_cluster
# ใช้ตัวอักษร/ตัวเลขล้วน เพราะ prod-compose.yml เอาไปประกอบเป็น DB_URL (อักขระ @ : / ทำ URL พัง)
# มีผลตอนสร้าง volume ครั้งแรกเท่านั้น — เปลี่ยนทีหลังต้องเปลี่ยนใน postgres ด้วย ALTER USER
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────
# ต้องยาว >= 32 ไม่งั้น backend ไม่ start — หลุด = ปลอม JWT เป็น admin ได้
#   openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HOURS=24
JWT_REMEMBER_TTL_DAYS=30

# ─────────────────────────────────────────────────────────────
# seed (รันให้อัตโนมัติทุกครั้งที่ up)
# ─────────────────────────────────────────────────────────────
# รหัสผ่านตั้งต้นของ admin (>= 12 ตัว) ใช้ตอนสร้างครั้งแรกเท่านั้น — มี admin แล้ว seed ไม่แตะอีก
# login ครั้งแรกแล้วเปลี่ยนรหัสในระบบ
#   openssl rand -base64 24
SEED_ADMIN_PASSWORD=
# ว่าง = production ไม่ใส่ข้อมูลสาธิต — ห้ามตั้ง true บนเครื่องจริง (บัญชีทดสอบมีรหัสผ่านอยู่ใน repo public)
SEED_DEMO_DATA=

# ─────────────────────────────────────────────────────────────
# Provisioner
# ─────────────────────────────────────────────────────────────
# mock = ยังไม่แตะคลัสเตอร์ (แค่ log) | kubernetes = deploy ของนักศึกษาลงคลัสเตอร์จริง
PROVISIONER=mock
# path "บน NUC" ของ kubeconfig ที่สร้างจาก ServiceAccount caesar-backend (ห้ามใช้ admin.conf)
# ใช้เมื่อ PROVISIONER=kubernetes · container รันเป็น uid 10001 ไฟล์ต้องให้ uid นี้อ่านได้:
#   sudo chown 10001:10001 <ไฟล์> && sudo chmod 400 <ไฟล์>
KUBECONFIG_HOST_PATH=

# ─────────────────────────────────────────────────────────────
# อีเมล (SMTP) — production บังคับตั้ง ไม่งั้น backend ไม่ start
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS | 465 = TLS ตั้งแต่ต้น
SMTP_PORT=587
# อีเมลเต็มของบัญชี no-reply
SMTP_USERNAME=
# App password 16 ตัวของ Google (ไม่ใช่รหัสล็อกอิน)
SMTP_PASSWORD=
MAIL_FROM_NAME=Caesar Cluster
# อีเมลที่ตอบกลับได้จริง (ว่าง = ไม่ใส่ Reply-To)
MAIL_REPLY_TO=
RESET_TOKEN_TTL_MINUTES=30
VERIFY_TOKEN_TTL_HOURS=24

# ─────────────────────────────────────────────────────────────
# Telemetry / Power — ว่าง = ปิดฟีเจอร์นั้น (ระบบอื่นทำงานปกติ)
# ─────────────────────────────────────────────────────────────
# PATH_PROMETHEUS_QUERY=http://<prometheus-host>:9090/api/v1/query?query=%s
PATH_PROMETHEUS_QUERY=
# PATH_PROMETHEUS_QUERY_RANGE=http://<prometheus-host>:9090/api/v1/query_range?query=%s&start=%d&end=%d&step=%s
PATH_PROMETHEUS_QUERY_RANGE=
# GET_POWERS_URL=http://<power-relay-host>/data.json
GET_POWERS_URL=
# เก็บ power_histories ย้อนหลังกี่วัน (ห้ามต่ำกว่า 30, 0 = ไม่ลบ)
POWER_HISTORY_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────
# Cluster AI
# ─────────────────────────────────────────────────────────────
# host:port ของ AI server — nginx proxy /ai → ที่นี่ (เปลี่ยนได้โดยไม่ต้อง build frontend ใหม่)
# ว่าง = /ai ตอบ 502 ส่วนอื่นของเว็บใช้ได้ปกติ
AI_UPSTREAM=
