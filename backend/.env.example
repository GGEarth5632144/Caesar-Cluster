# development = ผ่อน CORS ให้ localhost ทุกพอร์ต และเปิด debug log ของ gin
# production  = ล็อก CORS ไว้ที่ FRONTEND_ORIGIN อย่างเดียว และไม่ยอม start ถ้า JWT_SECRET ยังอ่อน
APP_ENV=development

PORT=8080
DB_URL=postgres://postgres:password@localhost:5433/cloud_cluster?sslmode=disable
JWT_SECRET=dev-secret
FRONTEND_ORIGIN=http://localhost:5173

# อายุ JWT ปกติ (ชม.) — ไม่ติ๊ก "Remember For 30 Days" ตอน login
JWT_TTL_HOURS=24
# อายุ JWT ตอนติ๊ก "Remember For 30 Days" (วัน)
JWT_REMEMBER_TTL_DAYS=30

# mock = ไม่แตะ cluster จริง (ใช้ตอน dev) | kubernetes = deploy ขึ้น k8s จริง
PROVISIONER=mock
# ใช้เมื่อ PROVISIONER=kubernetes เท่านั้น — path ของ kubeconfig
# เว้นว่างไว้ถ้า server รันอยู่ใน cluster เอง (จะใช้ in-cluster config)
KUBECONFIG=

# ---- ข้อมูลตั้งต้น (cmd/seed) ----
# ข้อมูลสาธิต = บัญชีทดสอบ B6618452 + รายชื่อ eligible ปลอม B6600001-B6600010
# ไม่ตั้ง = ใส่ให้ตอน dev, ไม่ใส่ตอน APP_ENV=production (ตั้งทับได้ทั้งสองทาง)
SEED_DEMO_DATA=
# รหัสผ่านตั้งต้นของบัญชี admin — ตอน dev ไม่ตั้งก็ได้ (ใช้ changeme123)
# ตอน production "บังคับตั้ง" ยาวอย่างน้อย 12 ตัว ไม่งั้น seed จะไม่ยอมรัน
SEED_ADMIN_PASSWORD=

# ---- ตัวสแกน log หา error แล้วส่งเข้าหน้า Alerts ----
# false = ปิดตัวสแกน (หน้า Alerts ยังเปิดดูได้ แต่จะไม่มีแจ้งเตือนใหม่เข้ามาเอง)
ALERT_SCAN_ENABLED=true
# ทุกกี่วินาทีจะเดินอ่าน log ของทุก service ที่ running อยู่หนึ่งรอบ
ALERT_SCAN_INTERVAL_SECONDS=60
# ดึง log ย้อนหลังสูงสุดกี่บรรทัดต่อ service ต่อรอบ (กัน container ที่พ่น log รัวๆ กินแรม)
ALERT_SCAN_MAX_LINES=500
# true = ส่ง warning เข้าหน้า Alerts ด้วย (ค่าปกติส่งเฉพาะ error)
ALERT_SCAN_INCLUDE_WARNINGS=false

# โควตาของ Gmail ฟรีคือ ~500 ฉบับ/วัน พอเหลือเฟือสำหรับลิงก์ยืนยันอีเมล + รีเซ็ตรหัสผ่านของระบบนี้
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (ค่าปกติ) | 465 = TLS ตั้งแต่ต้น ใช้เมื่อเน็ตปลายทางบล็อก 587
SMTP_PORT=587
# อีเมลเต็มของบัญชี no-reply — ว่างไว้ระบบยังรันบน dev ได้ แต่สมัครสมาชิกและรีเซ็ตรหัสผ่านจะใช้ไม่ได้
# (บน APP_ENV=production ไม่ยอม start เลยถ้าไม่ตั้ง เพราะลิงก์ยืนยันอยู่บนเส้นทางบังคับของการสมัคร)
SMTP_USERNAME=
# App password 16 ตัวจากขั้นตอนที่ 3
SMTP_PASSWORD=
# ชื่อที่ผู้รับเห็นหน้าอีเมลผู้ส่ง — ส่วนที่อยู่จะเป็น SMTP_USERNAME เสมอ (Gmail บังคับ)
MAIL_FROM_NAME=Caesar Cluster
# อีเมลที่ผู้ใช้ตอบกลับได้จริง (ว่าง = ไม่ใส่ header Reply-To)
# กล่อง no-reply ที่ตอบกลับไม่ได้เลยถูกตัวกรองสแปมหักคะแนน ใส่อีเมลผู้ดูแลไว้ช่วยให้เข้า inbox ง่ายขึ้น
MAIL_REPLY_TO=
# อายุของลิงก์รีเซ็ตรหัสผ่าน (นาที)
RESET_TOKEN_TTL_MINUTES=30
# อายุของลิงก์ยืนยันอีเมลตอนสมัคร (ชั่วโมง) — ยาวกว่าลิงก์รีเซ็ตเพราะคนเพิ่งสมัครอาจไปเปิดเมล
# เช้าวันรุ่งขึ้น ต่างจากคนกดรีเซ็ตที่นั่งรออยู่หน้าจอ
VERIFY_TOKEN_TTL_HOURS=24

PATH_PROMETHEUS_QUERY="http://BANANA.com/api/v1/query?query=%s"