# ค่าสำหรับรัน backend บนเครื่องตัวเอง (dev)
# สำหรับเครื่องจริงบน NUC ใช้ไฟล์ .env ที่ root ของ repo แทน (ดู .env.example ที่นั่น และ DEPLOY.md)

# development = ผ่อน CORS ให้ localhost ทุกพอร์ต และเปิด debug log ของ gin
# production  = ล็อก CORS ไว้ที่ FRONTEND_ORIGIN อย่างเดียว และไม่ยอม start ถ้า JWT_SECRET ยังอ่อน
APP_ENV=development

PORT=8080
DB_URL=postgres://postgres:password@localhost:5433/cloud_cluster?sslmode=disable
JWT_SECRET=dev-secret
FRONTEND_ORIGIN=http://localhost:5173

# อายุ JWT ปกติ (ชม.) — ไม่ติ๊ก "Remember For 30 Days" ตอน login
JWT_TTL_HOURS=24
# อายุ JWT ตอนติ๊ก "Remember For 30 Days" (วัน)
JWT_REMEMBER_TTL_DAYS=30

# mock = ไม่แตะ cluster จริง (ใช้ตอน dev) | kubernetes = deploy ขึ้น k8s จริง
PROVISIONER=mock
# ใช้เมื่อ PROVISIONER=kubernetes เท่านั้น — path ของ kubeconfig
# เว้นว่างไว้ = ลอง in-cluster config ก่อน แล้วค่อยตกไปที่ ~/.kube/config
KUBECONFIG=

# ---- ค่าที่ใช้เฉพาะตอน PROVISIONER=kubernetes ----
# ช่วง IP ของ pod ทั้งคลัสเตอร์ (ค่าของคลัสเตอร์นี้ตามเอกสารสถาปัตยกรรม)
K8S_POD_CIDR=172.16.0.0/16
# วง IP ที่ห้าม pod ของนักศึกษาต่อออกไป คั่นด้วย comma — กันไม่ให้ยิงเข้า SSH/kubelet ของ node
K8S_BLOCKED_EGRESS_CIDRS=192.168.100.0/24
# port ที่ใช้เมื่อ service ไม่ได้ระบุ container_port และไม่มี env var ชื่อ PORT
K8S_DEFAULT_CONTAINER_PORT=8080
# baseline = กัน privileged/hostPath/hostNetwork | restricted = บังคับ runAsNonRoot ด้วย
K8S_POD_SECURITY=baseline
K8S_IMAGE_PULL_POLICY=IfNotPresent
K8S_REQUEST_TIMEOUT_SECONDS=30

# ---- จำกัด image ที่ผู้ใช้ deploy ได้ (คั่นด้วย comma, ว่าง = ไม่จำกัด) ----
# ว่างไว้ตอน dev ได้ แต่บนเครื่องจริงต้องตั้ง ไม่งั้นนักศึกษารัน image อะไรก็ได้บนคลัสเตอร์
ALLOWED_IMAGE_REGISTRIES=

# ---- อีเมลรีเซ็ตรหัสผ่าน (Resend: https://resend.com) ----
# API key จาก Resend dashboard — ว่างไว้ระบบยังรันได้ แต่ส่งอีเมลรีเซ็ตรหัสผ่านไม่ได้
RESEND_API_KEY=
# ผู้ส่งอีเมล — โดเมนต้อง verify ใน Resend ก่อน (ตอน dev ใช้ onboarding@resend.dev ได้เลย)
MAIL_FROM=Caesar Cluster <onboarding@resend.dev>
# อายุของลิงก์รีเซ็ตรหัสผ่าน (นาที)
RESET_TOKEN_TTL_MINUTES=30
